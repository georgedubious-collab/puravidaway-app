{
  "expo": {
    "name": "CR Transfers",
    "slug": "crpt-traveller",
    "scheme": "crpttraveller",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.costaricaprivatetransfers.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.costaricaprivatetransfers.app",
      "adaptiveIcon": {
        "backgroundColor": "#047857",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#059669",
          "defaultChannel": "trips"
        }
      ],
      "expo-web-browser",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#047857",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "3beec35f-471f-4faa-abf5-f548ff348063"
      }
    },
    "owner": "costa-rica-private-transfers"
  }
}
