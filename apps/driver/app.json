{
  "expo": {
    "name": "CR Transfers Partner",
    "slug": "crpt-partner",
    "scheme": "crptpartner",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.costaricaprivatetransfers.partner",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.costaricaprivatetransfers.partner",
      "adaptiveIcon": {
        "backgroundColor": "#022C22",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#059669",
          "defaultChannel": "jobs"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Costa Rica Private Transfers shares your location with our team and your travellers from 3 hours before a pickup until you end the trip, so pickups can be coordinated.",
          "locationWhenInUsePermission": "Costa Rica Private Transfers uses your location to coordinate pickups during your trips.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Costa Rica Private Transfers uses the camera to photograph your documents and vehicles for verification.",
          "photosPermission": "Costa Rica Private Transfers lets you choose photos of your documents and vehicles for verification.",
          "microphonePermission": false
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "4cae122a-da6d-4df1-94e5-eece38a63447"
      }
    },
    "owner": "costa-rica-private-transfers",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/4cae122a-da6d-4df1-94e5-eece38a63447",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 4000
    }
  }
}
