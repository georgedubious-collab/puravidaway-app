{
  "expo": {
    "name": "CR Transfers Partner",
    "slug": "crpt-partner",
    "scheme": "crptpartner",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.costaricaprivatetransfers.partner"
    },
    "android": {
      "package": "com.costaricaprivatetransfers.partner",
      "adaptiveIcon": {
        "backgroundColor": "#022C22",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#059669",
          "defaultChannel": "jobs"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "4cae122a-da6d-4df1-94e5-eece38a63447"
      }
    },
    "owner": "costa-rica-private-transfers"
  }
}
