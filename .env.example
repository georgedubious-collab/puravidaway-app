# Copy to .env.local for local development. Set the same values in Vercel → Project Settings → Environment Variables.

# WhatsApp number for the concierge buttons, digits only with country code (Costa Rica = 506).
NEXT_PUBLIC_WHATSAPP_NUMBER=506XXXXXXXX

# Public site address (no trailing slash) for canonical links, sitemap and link previews.
# Defaults to https://puravidaway-app.vercel.app when unset.
# NEXT_PUBLIC_SITE_URL=https://costaricaprivatetransfers.com

# Pre-launch switch. Leave unset to keep the whole site out of Google (noindex + robots.txt block).
# At launch set to true in Vercel for the Production environment ONLY (never Preview).
# NEXT_PUBLIC_SITE_INDEXABLE=true

# Social media profiles shown as icons in the site footer and in the Organization data for search
# engines (src/lib/social.ts). Full https:// URLs. Leave unset until the account exists: an icon
# only appears when its URL is set. Planned: Facebook, Instagram, TikTok; later YouTube and X.
# NEXT_PUBLIC_SOCIAL_FACEBOOK=https://www.facebook.com/...
# NEXT_PUBLIC_SOCIAL_INSTAGRAM=https://www.instagram.com/...
# NEXT_PUBLIC_SOCIAL_TIKTOK=https://www.tiktok.com/@...
# NEXT_PUBLIC_SOCIAL_YOUTUBE=https://www.youtube.com/@...
# NEXT_PUBLIC_SOCIAL_X=https://x.com/...

# Supabase (Phase 2b) — see docs/SETUP-SUPABASE.md. Without these the storefront still works
# on the built-in catalog, and /login + /admin show a "not connected yet" notice.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server-only, never NEXT_PUBLIC_ — saves trip requests, chat, emails

# Public address of the site, used in email links (trip page) and page metadata.
NEXT_PUBLIC_SITE_URL=https://puravidaway-app.vercel.app

# Support email shown in the apps' Help screens (default drivers@costaricaprivatetransfers.com).
# Never a personal address: drivers and travellers see it.
# DRIVER_SUPPORT_EMAIL=drivers@costaricaprivatetransfers.com

# Vercel Cron secret (Vercel → Settings → Environment Variables; Vercel sends it with each scheduled
# call). Protects /api/cron/review-reminders (daily follow-up "please rate your driver" email).
# Any random string of 16+ characters.
CRON_SECRET=

# Lets the "Database migrations" GitHub Action refresh the cached price list after it runs
# (POST /api/revalidate-catalog). Server-only; at least 32 random characters; the same value
# goes in GitHub → Settings → Secrets → Actions as CATALOG_REVALIDATE_SECRET.
CATALOG_REVALIDATE_SECRET=

# Google Maps Platform (Places API (New) + Routes API) — server-only, never NEXT_PUBLIC_.
# Address search and road distances in the ride builder; without it only our towns are offered.
# Setup: docs/PRICING.md §3.1.
GOOGLE_MAPS_API_KEY=

# Email through Resend (trip confirmations, new-request alerts, chat notifications) — server-only.
# Until a sending domain is verified in Resend, EMAIL_FROM falls back to onboarding@resend.dev,
# which only delivers to the Resend account owner.
RESEND_API_KEY=
EMAIL_FROM="Costa Rica Private Transfers <hola@costaricaprivatetransfers.com>"
ADMIN_NOTIFY_EMAIL=                 # where the team receives new-request alerts

# Phase 2d (Green Pay) — not used yet, server-only
# GREENPAY_MERCHANT_ID=
# GREENPAY_SECRET=
