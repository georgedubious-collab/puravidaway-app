# Copy to .env.local for local development. Set the same values in Vercel → Project Settings → Environment Variables.

# WhatsApp number for the concierge buttons, digits only with country code (Costa Rica = 506).
NEXT_PUBLIC_WHATSAPP_NUMBER=506XXXXXXXX

# Supabase (Phase 2b) — see docs/SETUP-SUPABASE.md. Without these the storefront still works
# on the built-in catalog, and /login + /admin show a "not connected yet" notice.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server-only, never NEXT_PUBLIC_ — used from Phase 2d (checkout)

# Phase 2d (Green Pay) — not used yet, server-only
# GREENPAY_MERCHANT_ID=
# GREENPAY_SECRET=
